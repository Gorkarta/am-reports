n_r":0,"plan_src":"—","vit":["LA","М.Видео"],"d3":4,"short":"Дискотека Авария","dt":"27.12"},{"id":"35","name":"ПЕЛАГЕЯ","start":"2026-11-04 19:00","days_left":0,"created":"2026-04-27","sold":1090,"sold_p":707,"rev":4989000.0,"avg":7056.577086280056,"new_n":6,"new_r":34500.0,"w7":56,"pw7":83,"last":"2026-11-03 23:15","since_last":0.4,"cap":747,"inv":383,"chg":{"up":0,"dn":0,"pct":0.0,"added":0,"removed":0,"newgroups":0},"cap_sch":7189,"plan_t":7189,"plan_r":0,"plan_src":"—","vit":["LA","М.Видео"],"d3":12,"short":"ПЕЛАГЕЯ","dt":"04.11"},{"id":"57","name":"Akmal’","start":"2027-03-19 20:00","days_left":135,"created":"2026-08-05","sold":2186,"sold_p":2186,"rev":15406500.0,"avg":7047.804208600183,"new_n":33,"new_r":347500.0,"w7":172,"pw7":210,"last":"2026-11-04 06:46","since_last":0.1,"cap":7721,"inv":0,"chg":{"up":0,"dn":0,"pct":0.0,"added":0,"removed":0,"newgroups":0},"cap_sch":8109,"plan_t":8109,"plan_r":0,"plan_src":"—","vit":["LA","Афиша","Кассир","Яндекс"],"d3":65,"short":"Akmal’","dt":"19.03"}],"zero":"Не показаны (0 билетов): Идеальный исполнитель 05.11, Идеальный исполнитель 06.11, Женский стендап 07.03; не в продаже: . Очень малые продажи показаны минимальным размером.","help":"<h4>Принцип построения</h4><ul>\n<li>Данные — две последние выгрузки БС: «период» — между ними; все мероприятия архива, кроме тестовых и служебных.</li>\n<li>Билеты = реализовано: проданные + пригласительные − возвраты. Выручка — только по проданным (пригласительные = 0 ₽).</li>\n<li><b>Темп</b> — продажи за 7 дней к предыдущим 7: Высокий ≥1,3×; Средний 0,5–1,3×; Низкий &lt;0,5×, нет продаж 6+ дней или 0 за 7 дней. Если в предыдущие 7 дней было меньше 10 билетов: ≥10 за 7 дней — Высокий, 0 — Низкий, иначе Средний.</li>\n<li><b>Карточка:</b> «билеты/шт» — оплаченные (без пригласительных) к плану; «рубли/млн» — выручка к плану ₽; «Витрины» — опубликованные каналы продаж; «за 3 дня» — продажи по календарным дням, последний день неполный.</li>\n<li><b>План:</b> цель из карточки мероприятия (Михайлов 7 000 / 60 млн ₽; Blok3 10 857 / 60 млн ₽; Жара 78 — квота 747 / 2,3 млн ₽). Если цели нет: билеты — вместимость по схеме зала (места + лимит танцпола, включая невыведенные), план ₽ — «—».</li>\n<li><b>Карта продаж:</b> размер плитки — реализованные билеты; цвет: красный — плохо, зелёный — хорошо, насыщенность — сила изменения; режимы «Динамика 7 дней к предыдущим 7» и «Вклад в продажи периода».</li></ul>\n<h4>Ограничения</h4><ul>\n<li>Процент к плану разных мероприятий сравнивать нельзя без оговорки: разные залы, цены, жанры и срок до концерта.</li>\n<li>Без плана ₽ выполнение по рублям не считается; для квотных мероприятий (Жара 78) план — не весь зал.</li>\n<li>Темп — только динамика недель, а не оценка «хорошо / плохо» относительно кривой плана; новые и далёкие мероприятия с малыми продажами дают шумные цифры.</li>\n<li>Мероприятия без оплаченных билетов в карточках и на карте не показаны (список — внизу страницы). Очень малые продажи на карте показаны минимальным размером.</li>\n<li>Данные только БС; продажи на других площадках сюда не входят (справка по запросу). Время — МСК.</li><li>Подозрительные мероприятия (мало оплаченных при множестве пригласительных, цена втрое выше обычной, дубль сеанса) в сборку не попадают без решения владельца: дашборд строится только после ответа «исключить» или «оставить» (exclusions.json).</li>\n</ul>"}